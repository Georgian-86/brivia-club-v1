{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/profile.html", "destination": "/app.html?view=profile" },
    { "source": "/explore.html", "destination": "/app.html?view=explore" },
    { "source": "/chat.html", "destination": "/app.html?view=chat" }
  ]
}
