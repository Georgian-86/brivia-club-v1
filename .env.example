VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Guided signup methods (Phase E, D-060): a comma list of `google` and `email`, e.g. `google,email`.
# Empty or unset shows "Signups open soon" with Log in. That ONLY hides the signup buttons: to really close signups,
# also turn off Supabase Auth -> "Allow new users to sign up" (the login Google button and direct API calls can
# otherwise still create accounts). `email` needs custom SMTP with a Magic Link/OTP template containing {{ .Token }}.
VITE_SIGNUP_METHODS=
